# Virtualenvs — by cad and by opt
.venv-opt/
.venv-cad/

__pycache__/
*.py[cod]
.pytest_cache/
# Throwaway artifacts from `src/wheel_fea.py --smoke` and from experimental runs, whose
# figures are named after their --out genome.  The real best_solution.json, wheel.step,
# wheel_step_manifest.json and poster_summary.jpg ARE committed on purpose — they are
# the provenance chain the pipeline's staleness checks compare against.
best_solution_smoke.json
*_summary.jpg
.aider*

# The GUI's job registry: one directory per run, holding that run's log, its exit code,
# and whatever it was pointed at instead of the repo's default output names.  Local
# bookkeeping about THIS machine's runs, not provenance -- the artifacts a run is meant to
# contribute are committed by the driver that files them, deliberately and by hand.
gui/runs/

# The desktop shell's toolchain and its output. `gui/desktop/` is source -- four small
# files and an icon -- but Electron itself is ~150 MB restored by `npm install`, and the
# installers it builds are the same bytes again per platform.
gui/desktop/node_modules/
gui/desktop/dist/
